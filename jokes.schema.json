{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["jokes"],
  "properties": {
    "jokes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "integer"},
          "text": {"type": "string", "maxLength": 140}
        }
      }
    }
  }
}
